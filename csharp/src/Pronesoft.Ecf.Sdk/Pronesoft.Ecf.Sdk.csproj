<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo><!-- setting GenerateAssemblyInfo to false causes this bug https://github.com/dotnet/project-system/issues/3934 -->
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Pronesoft.Ecf.Sdk</AssemblyName>
    <PackageId>Pronesoft.Ecf.Sdk</PackageId>
    <OutputType>Library</OutputType>
    <Authors>ProneSoftSRL</Authors>
    <Company>ProneSoftSRL</Company>
    <AssemblyTitle>Pronesoft ECF SDK</AssemblyTitle>
    <Description>SDK para integración con la API de Comprobantes Fiscales Electrónicos (eCF) de Pronesoft</Description>
    <Copyright>Copyright © ProneSoftSRL</Copyright>
    <RootNamespace>Pronesoft.Ecf.Sdk</RootNamespace>
    <Version>0.0.3</Version>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\Pronesoft.Ecf.Sdk.xml</DocumentationFile>
    <RepositoryUrl>https://github.com/ProneSoftSRL/pronesoft-ecf-sdks.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Initial release</PackageReleaseNotes>
    <NoWarn>1591</NoWarn>
    <Nullable>annotations</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSubTypes" Version="2.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Polly" Version="8.2.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
</Project>
